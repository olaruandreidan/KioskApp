<UserControl x:Class="KioskApp.TimeLimitPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Image Display -->
        <Border Grid.Row="0"
                Background="#1E1E1E"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Image x:Name="GameImage"
                   Stretch="Uniform"
                   MaxWidth="500"
                   MaxHeight="300"/>
        </Border>

        <!-- Message Text -->
        <StackPanel Grid.Row="1"
                    Margin="20"
                    HorizontalAlignment="Center">
            <TextBlock x:Name="MessageText"
                       FontSize="30"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>
            <TextBlock x:Name="SubMessageText"
                       FontSize="26"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#CCCCCC"
                       Margin="0,0,0,10"/>
            <TextBlock x:Name="CountdownText"
                       FontSize="20"
                       TextAlignment="Center"
                       Foreground="#FF9999"
                       FontStyle="Italic"/>
        </StackPanel>

        <!-- Button -->
        <Button Grid.Row="2"
                x:Name="DismissButton"
                Content="OK"
                HorizontalAlignment="Center"
                Margin="20"
                Padding="40,10"
                FontSize="16"
                Click="DismissButton_Click"/>
    </Grid>
</UserControl>
